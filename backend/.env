# Configuración Oracle Cloud Database con Wallet
# Usuario de la base de datos
ORA_USER=Encargo_1

# NO necesitas password con wallet (se maneja automáticamente)
ORA_PASSWORD=Encargo1_EA1

# Connect String de Oracle Cloud con TNS_ADMIN incluido
ORA_CONNECT_STRING=bdy1102_high

# Ubicación del Oracle Wallet (TNS_ADMIN)
ORA_WALLET_LOCATION=C:/Users/mmelo/Desktop/wallet

# Configuración SSL para Oracle Cloud
ORA_SSL=true
ORA_SSL_SERVER_CERT_DN=CN=adb.sa-valparaiso-1.oraclecloud.com

# Puerto del servidor Express
PORT=3000
